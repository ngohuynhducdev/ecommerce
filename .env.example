# Copy to .env.local and fill in. Every value below is optional except
# AUTH_SECRET — the app runs on in-repo mock data out of the box.

# ── Auth (required) ───────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# ── Data source ───────────────────────────────────────────────────────────────
# false → resolve products, categories and posts from src/features/*/mock-data.ts
# true  → fetch from the Strapi v5 REST API below (falls back to mock on error)
NEXT_PUBLIC_USE_STRAPI=false
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
# Read-only Strapi API token. Server-side only — never exposed to the browser.
STRAPI_API_TOKEN=

# ── Google OAuth (optional) ───────────────────────────────────────────────────
# Leave blank to hide the "Sign in with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── SEO (optional) ────────────────────────────────────────────────────────────
# Canonical origin used by metadataBase, sitemap.xml and robots.txt.
# Defaults to the production URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
